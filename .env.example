# Twitch API Credentials
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Groq API Key (for transcription)
GROQ_API_KEY=your_groq_api_key

# Twitch Channels (comma-separated)
TWITCH_CHANNELS=xqc, shroud, ninja, pokimane

# Twitch Categories (comma-separated)
TWITCH_CATEGORIES=Just Chatting, Valorant, Minecraft

# Opus Clip API Key (optional)
OPUS_CLIP_API_KEY=your_opus_api_key
