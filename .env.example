# Twitch API Credentials
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Groq API Key (for transcription)
GROQ_API_KEY=your_groq_api_key

# Database URL (Supabase PostgreSQL connection string)
# Format: postgresql+asyncpg://username:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres.your_project_ref:your_password@host.pooler.supabase.com:6543/postgres

# Supabase (optional - for future features)
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# JWT Secret Key (generate a secure random key)
SECRET_KEY=your_256bit_secret_key_here
ALGORITHM=HS256

# Twitch Channels (comma-separated)
TWITCH_CHANNELS=xqc, shroud, ninja, pokimane

# Twitch Categories (comma-separated)
TWITCH_CATEGORIES=Just Chatting, Valorant, Minecraft

# Opus Clip API Key (optional)
OPUS_CLIP_API_KEY=your_opus_api_key
