# ==============================================================================
# Clipder — Environment Variables
# Copy this file to .env and fill in your values.
# ==============================================================================

# ---- DATABASE (REQUIRED) ----
# PostgreSQL connection string using the asyncpg driver.
# Example: postgresql+asyncpg://user:password@localhost:5432/clipder
DATABASE_URL=

# ---- JWT AUTH (REQUIRED) ----
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Algorithm and token lifetime (optional, defaults shown)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- TWITCH API (REQUIRED) ----
# Create an app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# OAuth callback — update if you change the host/port
TWITCH_REDIRECT_URI=http://localhost:8000/api/v1/auth/twitch/callback

# ---- TWITCH CONTENT (REQUIRED) ----
# Comma-separated channel names to fetch clips from
TWITCH_CHANNELS=
# Comma-separated Twitch category names
TWITCH_CATEGORIES=Just Chatting,VALORANT,League of Legends

# ---- GROQ AI (REQUIRED for AI features) ----
# Get a key at https://console.groq.com
GROQ_API_KEY=

# ---- CORS (optional) ----
# Frontend origin for CORS. Default: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---- SUPABASE (optional) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- OPUS CLIP (optional) ----
OPUS_CLIP_API_KEY=
