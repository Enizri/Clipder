# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Twitch API Credentials
TWITCH_CLIENT_ID=...
TWITCH_CLIENT_SECRET=...


# Groq API Key (for transcription)
GROQ_API_KEY=...

# Database URL (Supabase PostgreSQL connection string)
# Format: postgresql+asyncpg://username:password@host:port/database
DATABASE_URL=...

# Supabase (optional - for future features)
SUPABASE_URL=...
SUPABASE_ANON_KEY=...

# JWT Secret Key (generate a secure random key)
SECRET_KEY=...
ALGORITHM=...

# Twitch Channels (comma-separated)
TWITCH_CHANNELS=...

# Twitch Categories (comma-separated)
TWITCH_CATEGORIES=...

# Opus Clip API Key (optional)
OPUS_CLIP_API_KEY=...
