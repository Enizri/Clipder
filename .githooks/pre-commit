#!/usr/bin/env python3
"""Block commits that contain credentials. Bypass (discouraged): git commit --no-verify"""
import re
import subprocess
import sys

# Filenames that should never be committed, regardless of content.
BLOCKED_NAMES = [
    (re.compile(r"(^|/)client_secrets?\.json$"), "Google OAuth client secrets"),
    (re.compile(r"\.pickle$"), "pickled credentials/tokens"),
    (re.compile(r"(^|/)\.env(\.|$)(?!.*example)"), ".env file"),
    (re.compile(r"(^|/)token\.json$"), "OAuth token"),
    (re.compile(r"(^|/)service[-_]account.*\.json$"), "GCP service account key"),
    (re.compile(r"\.(pem|p12|pfx|key)$"), "private key material"),
]

# High-confidence provider prefixes only, to keep false positives near zero.
SECRETS = [
    (re.compile(rb"GOCSPX-[A-Za-z0-9_-]{20,}"), "Google OAuth client secret"),
    (re.compile(rb"ya29\.[A-Za-z0-9_-]{40,}"), "Google OAuth access token"),
    (re.compile(rb"1//[A-Za-z0-9_-]{40,}"), "Google OAuth refresh token"),
    (re.compile(rb"AIza[A-Za-z0-9_-]{35}"), "Google API key"),
    (re.compile(rb"AKIA[0-9A-Z]{16}"), "AWS access key ID"),
    (re.compile(rb"sk-ant-[A-Za-z0-9_-]{20,}"), "Anthropic API key"),
    (re.compile(rb"xox[baprs]-[A-Za-z0-9-]{20,}"), "Slack token"),
    (re.compile(rb"gh[pousr]_[A-Za-z0-9]{36}"), "GitHub token"),
    (re.compile(rb"github_pat_[A-Za-z0-9_]{50,}"), "GitHub fine-grained PAT"),
    (re.compile(rb"glpat-[A-Za-z0-9_-]{20,}"), "GitLab token"),
    (re.compile(rb"-----BEGIN [A-Z ]*PRIVATE KEY-----"), "private key"),
]

# Lock files and minified bundles carry base64 hashes that look like secrets.
SKIP = re.compile(r"(package-lock\.json|yarn\.lock|pnpm-lock\.yaml|uv\.lock|poetry\.lock)$|\.min\.(js|css)$")


def staged_files():
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True, text=True, check=True,
    )
    return [f for f in out.stdout.splitlines() if f]


def main():
    problems = []
    for path in staged_files():
        for pattern, label in BLOCKED_NAMES:
            if pattern.search(path):
                problems.append(f"  {path}\n      blocked filename: {label}")
        if SKIP.search(path):
            continue
        blob = subprocess.run(
            ["git", "show", f":{path}"], capture_output=True
        ).stdout
        if b"\0" in blob[:8000]:  # binary
            continue
        for pattern, label in SECRETS:
            hit = pattern.search(blob)
            if hit:
                line = blob[: hit.start()].count(b"\n") + 1
                token = hit.group().decode("utf-8", "replace")
                problems.append(f"  {path}:{line}\n      {label}: {token[:12]}...")
                break

    if problems:
        sys.stderr.write(
            "\nCommit blocked - credentials detected:\n\n"
            + "\n".join(problems)
            + "\n\nRemove the secret, or add the file to .gitignore.\n"
              "If this is a false positive: git commit --no-verify\n\n"
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
